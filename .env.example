# Hami / ForgeOS environment template — NAMES ONLY, no values.
# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
# Node environment name
NODE_ENV=
# HTTP host to bind
HOST=
# HTTP port
PORT=
# Set by Vercel automatically in production
VERCEL=
# Production flag
PROD=
# Deployed commit SHA (Vercel provides VERCEL_GIT_COMMIT_SHA)
COMMIT_SHA=
GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_SHA=

# --- Database ---
# Primary database URL (Postgres); unset = local fallback
DATABASE_URL=
# Database URL for tests
FORGEOS_TEST_DATABASE_URL=

# --- Auth / scheduled jobs ---
# Owner API key for protected endpoints
FORGE_API_KEY=
# HMAC secret authorizing Vercel cron calls
CRON_SECRET=
# HMAC key for Forge Bot contact flows
FORGE_BOT_CONTACT_HMAC_KEY=
# Forge Bot live flag (default off)
FORGE_BOT_LIVE=
# Feature flags
VITE_AUTH_ENABLED=
FORGEOS_LEGACY_INTELLIGENCE_ENABLED=

# --- AI providers ---
AI_PROVIDER=
AI_FALLBACK_TO_MOCK=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_HOST=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=
EMBEDDING_PROVIDER=
COGNITIVE_PROVIDER=
QWEN_MODEL_NAME=

# --- Payments (Nepal) ---
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=
KHALTI_SECRET_KEY=
KHALTI_API_BASE_URL=

# --- Comms ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Integrations ---
GITHUB_TOKEN=
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# --- WebRTC / media ---
VITE_STUN_URLS=

# --- Engine tuning (all UNKNOWN defaults unless documented) ---
FORGEOS_CLAIM_LINK_LIMIT=
FORGEOS_COLLECT_LIMIT=
FORGEOS_EVIDENCE_FRESH_DAYS=
FORGEOS_LIVE_GDELT_TEST=
FORGEOS_LIVE_OPENALEX_TEST=
FORGEOS_RESUME_LIMIT=
FORGEOS_SUBSTRATE_EVIDENCE_BATCH=
FORGEOS_SUBSTRATE_LINK_BATCH=

# --- Test harness (set by pytest itself) ---
PYTEST_CURRENT_TEST=
