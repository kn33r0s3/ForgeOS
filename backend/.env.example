# Copy this file to .env and fill in as needed.
#
# FORGE RUNS AT $0 BY DEFAULT. Nothing below is required — the default
# settings (AI_PROVIDER=mock, EMBEDDING_PROVIDER=hash, SQLite) need no
# API key, no credit card, no subscription, and no internet connection
# at all.

# AI provider: "mock" (default, free, offline, zero setup),
#              "ollama" (free, local, real model — needs Ollama running),
#              "openai" (OPTIONAL paid acceleration — never required)
AI_PROVIDER=mock

# --- Only used if AI_PROVIDER=ollama ---
# Requires Ollama installed and running locally: https://ollama.com
#   ollama pull qwen3-coder:latest
#   ollama serve
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:latest
QWEN_MODEL_NAME=qwen3-coder:latest
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Only used if AI_PROVIDER=openai (optional paid acceleration) ---
# Also requires: pip install -r requirements-optional.txt
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Forge Memory Layer: embeddings/semantic search.
# "hash" (default) needs nothing — pure Python, zero cost, zero network.
# "ollama" upgrades to a real local embedding model (still free, still
# local) via the same Ollama server as AI_PROVIDER=ollama:
#   ollama pull nomic-embed-text
EMBEDDING_PROVIDER=hash
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
HASH_EMBEDDING_DIM=128

# SQLite database path — free and local. Leave unset to use the canonical
# absolute repository storage/forge.db; never use a relative URL for real data.
# DATABASE_URL=sqlite:////absolute/path/to/ForgeOS/storage/forge.db

# --- Real Nepal payment integrations ---
# Obtain production merchant credentials directly from each provider.
# Never commit these values. The payment adapters fail closed when absent.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://esewa.com.np/api/epay/transaction/status/
KHALTI_SECRET_KEY=
KHALTI_API_BASE_URL=https://khalti.com/api/v2

# Protect state-changing endpoints when deployed beyond localhost.
FORGE_API_KEY=
